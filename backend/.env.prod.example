# =====================================================
# backend/.env.prod.example  ->  copie para backend/.env.prod e preencha.
# NUNCA versione o .env.prod real (ja coberto por .gitignore: .env*).
# =====================================================

# --- Ambiente ---
APP_ENV=production

# --- Banco de dados ---
# Postgres roda como CONTAINER na mesma rede (root_default). Host = nome do
# servico/container -> `postgres` (porta interna 5432). NAO use 15432 (aquilo
# era o tunel SSH da maquina de dev). Crie o usuario dedicado `taskmanager`
# (dono do banco) antes -- ver DEPLOY.md.
DATABASE_URL=postgresql+asyncpg://taskmanager:TROQUE_ESTA_SENHA@postgres:5432/task_manager?ssl=disable

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Autenticacao / JWT ---
# Gere: openssl rand -hex 32
JWT_SECRET_KEY=TROQUE_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- CORS ---
# Topologia A (mesma origem via Traefik): o browser nunca faz cross-origin, entao
# o CORS quase nao e exercido. Deixe o dominio do app mesmo assim.
CORS_ALLOW_ORIGINS=https://task.srv1186064.hstgr.cloud

# --- Rate limit (login, por CONTA) -- Spec 030 D5 ---
# O unico freio do login: o por IP saiu em 21/10 (a instituicao sai por um IP
# so, e a 11a pessoa no minuto levava 429 com a senha certa). Este e por
# (e-mail + workspace) e conta apenas FALHA: acertar a senha zera. Destrava
# sozinho ao fim da janela.
ACCOUNT_LOGIN_LIMIT_MAX=10
ACCOUNT_LOGIN_LIMIT_WINDOW_SECONDS=900

# --- Rate limit (formulario publico de solicitacoes) ---
# Unica rota de escrita publica alem do auth. Balde proprio, por IP.
PUBLIC_FORM_RATE_LIMIT_MAX=30
PUBLIC_FORM_RATE_LIMIT_WINDOW_SECONDS=60

# --- Senha provisoria (ADR 0019) ---
# Janela de validade da provisoria gerada no cadastro/reset. Expirada => 401.
TEMPORARY_PASSWORD_TTL_HOURS=72

# --- Auto-arquivamento (Spec 013) ---
# Varredura diaria que arquiva tasks COMPLETED/CANCELLED paradas ha N dias.
STALE_ARCHIVE_DAYS=20
# Token do endpoint de varredura (POST /api/v1/system/tasks/archive-stale),
# chamado pelo n8n. VAZIO = endpoint desligado. Gere: openssl rand -hex 32.
# ⚠️ VAZIO NO EXEMPLO, de proposito: um valor de exemplo copiado sem trocar
# deixaria as rotas de sistema abertas a quem le este repositorio PUBLICO.
SYSTEM_API_TOKEN=
