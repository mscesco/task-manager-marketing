# =====================================================
# .env.example
# Copie para .env e preencha. NUNCA versione o .env real.
# =====================================================

# --- Ambiente ---
# Valores: development | staging | production
APP_ENV=development
APP_DEBUG=true

# --- Banco de dados ---
# Postgres EXTERNO da VPS. Em dev usa o database task_manager_dev.
# Driver async obrigatorio: postgresql+asyncpg
# Se o Postgres roda no host da VPS, use host.docker.internal
# (mapeado no docker-compose via extra_hosts).
DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@host.docker.internal:15432/task_manager_dev?ssl=disable

# Pool de conexoes (ajustar com carga real).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Autenticacao / JWT ---
# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Logging ---
# Formato: json (prod/staging) | console (dev, colorido)
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- CORS ---
# Lista separada por virgula. Em dev, o frontend Next.js local.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Testes de integracao (opcional) ---
# Apontado para o container db-test do compose. Quando ausente, a suite
# de integracao e PULADA (a de logica pura roda normalmente).
# TEST_DATABASE_URL=postgresql+asyncpg://test:test@db-test:5432/taskmanager_test

# --- Aviso de mudanca de status ao solicitante (Spec 043, fatia F) ---
# A cada mudanca de status de uma solicitacao, o backend faz POST nesta URL
# com o solicitante e o pedido; o n8n manda o e-mail.
#
# AMBAS VAZIAS = RECURSO DESLIGADO, e nao erro. Sem n8n configurado nada
# falha -- so nao sai aviso.
#
# A URL e a "Production URL" do no Webhook (existe so com o workflow ATIVO;
# a "Test URL" so responde enquanto voce esta ouvindo no editor).
# O token vai no header X-Webhook-Token e tem de ser o mesmo da credencial
# Header Auth do no. Gere com: openssl rand -hex 24
# N8N_WEBHOOK_URL=https://seu-n8n/webhook/solicitacao-status-xxxx
# N8N_WEBHOOK_TOKEN=
# N8N_WEBHOOK_TIMEOUT_SECONDS=5
